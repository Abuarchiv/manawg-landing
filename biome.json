{
	"$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" },
			"suspicious": {
				"noExplicitAny": "warn",
				"noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } },
				"noArrayIndexKey": "off"
			},
			"a11y": { "noAriaHiddenOnFocusable": "off" }
		}
	},
	"formatter": { "enabled": true, "indentStyle": "tab", "indentWidth": 2, "lineWidth": 100 },
	"javascript": {
		"formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" },
		"parser": { "unsafeParameterDecoratorsEnabled": true }
	},
	"json": { "formatter": { "enabled": true } },
	"files": {
		"ignore": [
			"node_modules",
			".next",
			".next-*",
			".vercel",
			"coverage",
			"test-results",
			"playwright-report",
			"graphify-out",
			"src/components/landing/engine/**",
			"tools/out",
			"site",
			"site-1zu1",
			"design"
		]
	},
	"overrides": [
		{ "include": ["tools/**"], "linter": { "rules": { "suspicious": { "noConsole": "off" } } } }
	]
}
