{
	"name": "manawg-landing",
	"version": "0.1.0",
	"private": true,
	"description": "Website of ManaWG (manawg.com), the free, open-source app for shared flats",
	"license": "Apache-2.0",
	"repository": "github:Abuarchiv/manawg-landing",
	"homepage": "https://manawg.com",
	"packageManager": "pnpm@9.0.0",
	"engines": { "node": ">=22", "pnpm": ">=9" },
	"browserslist": ["chrome >= 111", "edge >= 111", "firefox >= 111", "safari >= 16.4"],
	"scripts": {
		"dev": "next dev --port 3100",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"src/**/*.test.ts\"",
		"lint": "biome check .",
		"format": "biome format --write .",
		"clean": "rm -rf .next node_modules/.cache"
	},
	"dependencies": {
		"lenis": "^1.3.27",
		"lucide-react": "^1.61.0",
		"next": "^16.4.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/node": "^22",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"autoprefixer": "^10.6.1",
		"postcss": "^8.5.31",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.7.0"
	}
}
