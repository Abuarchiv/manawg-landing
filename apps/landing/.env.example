# ============================================================
# apps/landing — Environment Variables
# ============================================================
# Die Marketing-Zone. Sie besitzt die Domain-Wurzel und leitet
# /wg, /api, /neu, /offline und /.well-known an apps/web weiter
# (siehe next.config.ts). Beide Zonen müssen unter derselben
# Origin laufen — die Identität liegt in localStorage.
# ============================================================

# Öffentliche App-URL — für Sitemap, robots, OG-Bilder, Canonical.
# Muss mit dem Wert in apps/web übereinstimmen, sonst widersprechen
# sich die Metadaten der beiden Zonen.
NEXT_PUBLIC_APP_URL=https://manawg.com

# Rewrite-Ziel: die eigene Deployment-URL der App-Zone (apps/web).
# Lokal zeigt der Default auf http://localhost:3000.
APP_ZONE_URL=https://manawg-abditubes-projects.vercel.app
