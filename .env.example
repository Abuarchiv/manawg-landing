# ============================================================
# manawg-landing — Environment Variables
# ============================================================
# The marketing site (manawg.com). Fully independent from the app
# (app.manawg.com, separate repo/deployment) — connected only by a
# hyperlink and by the redirects below for old bookmarked app paths.
# ============================================================

# This site's own public URL — for sitemap, robots, OG images, canonical.
NEXT_PUBLIC_APP_URL=https://manawg.com

# Redirects for old /wg, /neu, /offline links and the /.well-known rewrite
# always target https://app.manawg.com (see next.config.ts).
